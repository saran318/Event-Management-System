# Database Connection URL (e.g., PostgreSQL or SQLite)
# Example: postgresql://username:password@host:6543/postgres
SUPABASE_DB_URL=postgresql://username:password@host:6543/postgres

# Flask Secret Key for sessions and security
SECRET_KEY=your_secret_key_here

# SMTP Email Configuration
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=noreply@example.com
